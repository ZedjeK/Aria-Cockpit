<Project Sdk="Microsoft.NET.Sdk">

  <!-- Banc d'essai 3D d'Aria Cockpit : un exe à part, pour qu'un plantage du rendu ne fasse pas tomber le cockpit -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Aria.Bench</RootNamespace>
    <AssemblyName>Aria-Bench</AssemblyName>
    <AssemblyTitle>Aria Bench</AssemblyTitle>
    <ApplicationIcon>..\Aria.Gui\Assets\Aria-Cockpit.ico</ApplicationIcon>
    <!-- Publication (avec -r win-x64) : un seul Aria-Bench.exe, compilateur de shaders inclus -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct3D 12, DXGI et compilateur de shaders DXC pour .NET (MIT) -->
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Dxc" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aria.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shaders HLSL intégrés à l'exe, compilés au lancement -->
    <EmbeddedResource Include="Shaders\*.hlsl" LogicalName="Aria.Bench.Shaders.%(Filename).hlsl" />
  </ItemGroup>

</Project>
