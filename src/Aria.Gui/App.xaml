<Application
  x:Class="Aria.Gui.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  DispatcherUnhandledException="OnUnhandledException"
  Startup="OnStartup">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Theme/Futuriste.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

      <!--
        Remplacement de couleurs du thème WPF-UI. Définies ici directement (et non dans un dictionnaire
        fusionné), elles sont prioritaires sur le thème, même s'il est rechargé.
      -->
      <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF030812" />
      <!-- Cockpit : angles quasi droits pour les contrôles WPF-UI (boutons, cartes, champs) -->
      <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
      <CornerRadius x:Key="PopupCornerRadius">2</CornerRadius>
      <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
      <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="CardBackground" Color="#B30A1428" />
      <SolidColorBrush x:Key="CardBackgroundPointerOver" Color="#D90F1C36" />
      <SolidColorBrush x:Key="CardBackgroundPressed" Color="#E6142442" />
      <SolidColorBrush x:Key="CardBorderBrush" Color="#407DF9FF" />
      <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE6F4FF" />
      <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF8FA6C4" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
