<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms ne sert qu'à l'icône de la zone de notification (Services\TrayIcon.cs) -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Le DPI reste réglé par app.manifest (PerMonitorV2, indispensable au diagnostic des écrans) : Windows Forms n'a pas de fenêtre ici -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Aria.Gui</RootNamespace>
    <AssemblyName>Aria-Cockpit</AssemblyName>
    <!-- « Description du fichier » dans Windows -->
    <AssemblyTitle>Aria Cockpit</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icône de l'exe (Explorateur, barre des tâches) : Assets\logo.svg rendu en 16 à 256 px -->
    <ApplicationIcon>Assets\Aria-Cockpit.ico</ApplicationIcon>

    <!-- Publication : un seul Aria-Cockpit.exe autonome -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Pas de compression : un exe qui se décompresse lui-même alerte souvent les antivirus (fichier plus gros, en contrepartie) -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Contrôles au style Windows 11 (Fluent, Mica, thème clair/sombre) -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- Liaison interface ↔ logique (MVVM), bibliothèque officielle Microsoft -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Noms de Windows Forms (Application, Button, Color…) : jamais importés d'office, ils se confondraient avec ceux de WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Même icône pour la fenêtre -->
    <Resource Include="Assets\Aria-Cockpit.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aria.Core\Aria.Core.csproj" />
  </ItemGroup>

</Project>
