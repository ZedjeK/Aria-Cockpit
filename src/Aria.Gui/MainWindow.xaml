<ui:FluentWindow
  x:Class="Aria.Gui.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fx="clr-namespace:Aria.Gui.Effects"
  xmlns:services="clr-namespace:Aria.Gui.Services"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:views="clr-namespace:Aria.Gui.Views"
  Title="Aria Cockpit"
  Width="1240"
  Height="820"
  Icon="pack://application:,,,/Assets/Aria-Cockpit.ico"
  MinWidth="900"
  MinHeight="600"
  Background="{StaticResource SpaceBackgroundBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{StaticResource NeonTextBrush}"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen">
  <Grid>
    <!-- Menu latéral à gauche (colonne 0, sur toute la hauteur), pages à droite (colonne 1) -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="212" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Décor : nuit profonde, grille fine et halo bleu au centre ===== -->
    <Rectangle Grid.RowSpan="3" Grid.ColumnSpan="2" Fill="{StaticResource SpaceBackgroundBrush}" IsHitTestVisible="False" />
    <Rectangle Grid.RowSpan="3" Grid.ColumnSpan="2" Fill="{StaticResource GridBrush}" IsHitTestVisible="False" />
    <Ellipse
      Grid.RowSpan="3"
      Grid.ColumnSpan="2"
      Width="1100"
      Height="900"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Offset="0" Color="#2E5C8BFF" />
          <GradientStop Offset="1" Color="#005C8BFF" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse
      Grid.RowSpan="3"
      Grid.ColumnSpan="2"
      Width="900"
      Height="700"
      Margin="0,0,-360,-380"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom"
      IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Offset="0" Color="#16FF8A1F" />
          <GradientStop Offset="1" Color="#00FF8A1F" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <!-- ===== Menu latéral : logo, pages, version. Panneau opaque : le fond animé ne passe jamais dessous ===== -->
    <Border
      Grid.RowSpan="3"
      Background="{StaticResource PanelBrush}"
      BorderBrush="{StaticResource LineBrush}"
      BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- Le logo sert aussi de poignée : on déplace la fenêtre en l'attrapant, comme par la barre de titre -->
        <StackPanel
          Margin="18,20,12,22"
          Background="Transparent"
          DockPanel.Dock="Top"
          MouseLeftButtonDown="OnHeaderMouseDown"
          Orientation="Horizontal">
          <views:AriaLogo Width="44" Height="44" />
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock
              FontSize="22"
              FontWeight="Bold"
              Style="{StaticResource NeonTitle}"
              Text="ARIA" />
            <TextBlock
              Margin="1,-3,0,0"
              FontFamily="{StaticResource TechFont}"
              FontSize="11"
              FontWeight="SemiBold"
              Foreground="{StaticResource NeonOrangeBrush}"
              Text="C O C K P I T" />
          </StackPanel>
        </StackPanel>

        <StackPanel Margin="22,0,12,16" DockPanel.Dock="Bottom">
          <TextBlock
            x:Name="VersionText"
            FontFamily="{StaticResource MonoFont}"
            FontSize="11"
            Foreground="{StaticResource NeonMutedBrush}" />
          <TextBlock
            Margin="0,2,0,0"
            FontFamily="{StaticResource MonoFont}"
            FontSize="11"
            Foreground="#FF5E7290"
            Text="tout en local" />
        </StackPanel>

        <!-- Pages : chaque entrée mène à sa page (Tag = type de la page). Fenêtre basse : la liste défile. -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="Tabs" RadioButton.Checked="OnTabChecked">
            <RadioButton x:Name="DashboardTab" Content="MON PC" IsChecked="True" Style="{StaticResource HudNav}" Tag="{x:Type views:DashboardPage}" />
            <RadioButton Content="OPTIMISATION" Style="{StaticResource HudNav}" Tag="{x:Type views:SettingsPage}" />
            <RadioButton Content="RÉGLAGE GPU" Style="{StaticResource HudNav}" Tag="{x:Type views:GpuTuningPage}" />
            <RadioButton Content="MISES À JOUR" Style="{StaticResource HudNav}" Tag="{x:Type views:UpdatesPage}" />
            <RadioButton Content="NETTOYAGE" Style="{StaticResource HudNav}" Tag="{x:Type views:CleanupPage}" />
            <RadioButton Content="RESTAURATION" Style="{StaticResource HudNav}" Tag="{x:Type views:RestorePage}" />
            <RadioButton Content="RAPPORTS" Style="{StaticResource HudNav}" Tag="{x:Type views:ReportsPage}" />
            <!-- Paramètres de l'appli elle-même (démarrage, fenêtre, données), à part des réglages du PC -->
            <RadioButton Content="PARAMÈTRES" Style="{StaticResource HudNav}" Tag="{x:Type views:PreferencesPage}" ToolTip="Paramètres d'Aria Cockpit" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ===== Barre de titre : la bande qu'on attrape pour déplacer la fenêtre, au-dessus des pages ===== -->
    <Border
      Grid.Row="0"
      Grid.Column="1"
      Height="44"
      Background="Transparent"
      MouseLeftButtonDown="OnHeaderMouseDown" />

    <!-- Boutons réduire / agrandir / fermer : seuls, en haut à droite -->
    <ui:TitleBar
      Grid.Row="0"
      Grid.Column="1"
      Width="190"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Title="" />

    <!-- ===== Bandeau « nouvelle version », affiché seulement si GitHub publie une release plus récente ===== -->
    <Border
      x:Name="UpdateBanner"
      Grid.Row="1" Grid.Column="1"
      Padding="22,10"
      Background="#1FFF8A1F"
      BorderBrush="#66FF8A1F"
      BorderThickness="0,0,0,1"
      Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="UpdateLabel" VerticalAlignment="Center" Style="{StaticResource HudCode}" Text="MISE À JOUR DISPONIBLE" />
        <TextBlock
          x:Name="UpdateText"
          Grid.Column="1"
          Margin="16,0"
          VerticalAlignment="Center"
          Foreground="{StaticResource NeonTextBrush}"
          TextTrimming="CharacterEllipsis" />
        <Button
          x:Name="UpdateButton"
          Grid.Column="2"
          MinHeight="32"
          Padding="20,0"
          Click="OnOpenUpdate"
          Content="VOIR"
          Style="{StaticResource HudButton}"
          ToolTip="Montre ce qui change et propose de télécharger la nouvelle version. Rien n'est téléchargé à l'ouverture." />
        <ui:Button
          Grid.Column="3"
          Margin="10,0,0,0"
          Padding="8"
          Appearance="Transparent"
          Click="OnCloseUpdate"
          Icon="{ui:SymbolIcon Dismiss16}"
          ToolTip="Masquer jusqu'au prochain lancement" />
      </Grid>
    </Border>

    <!-- ===== Fond animé : le balayage, sous les pages seulement, jamais sous le menu latéral ===== -->
    <fx:SweepBackdrop Grid.Row="2" Grid.Column="1" />

    <!--
      Hôte des pages : un cadre sans barre de navigation, dans un défilement vertical commun à toutes les pages.
      Le menu latéral choisit la page affichée.
    -->
    <ui:DynamicScrollViewer
      x:Name="PageScroller"
      Grid.Row="2" Grid.Column="1"
      HorizontalScrollBarVisibility="Disabled"
      VerticalScrollBarVisibility="Auto">
      <Frame
        x:Name="PageHost"
        Focusable="False"
        JournalOwnership="OwnsJournal"
        NavigationUIVisibility="Hidden" />
    </ui:DynamicScrollViewer>

    <!-- ===== Écran d'analyse ===== -->
    <Grid
      Grid.Row="2" Grid.Column="1"
      fx:Fx.Sweep="True"
      Background="#E6030812"
      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="150" Height="150">
          <Ellipse
            fx:Fx.Spin="True"
            Stroke="#997DF9FF"
            StrokeDashArray="2 6"
            StrokeThickness="2" />
          <ui:ProgressRing
            Width="96"
            Height="96"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsIndeterminate="True" />
        </Grid>
        <TextBlock
          Margin="0,26,0,6"
          HorizontalAlignment="Center"
          fx:Fx.Pulse="True"
          FontFamily="{StaticResource TechFont}"
          FontSize="20"
          FontWeight="SemiBold"
          Foreground="{StaticResource NeonCyanBrush}"
          Text="{Binding BusyText}" />
        <TextBlock
          HorizontalAlignment="Center"
          Style="{StaticResource HudCode}"
          Text="LECTURE SEULE · AUCUNE MODIFICATION" />
      </StackPanel>
    </Grid>

    <!-- ===== Mise à jour d'Aria Cockpit : proposition, téléchargement, contrôle de l'empreinte ===== -->
    <views:AppUpdateOverlay
      x:Name="UpdateOverlay"
      Grid.Row="2" Grid.Column="1"
      Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />

    <!-- ===== Confirmations, intégrées à la fenêtre (barre de titre laissée libre) ===== -->
    <views:DialogOverlay
      Grid.Row="2" Grid.Column="1"
      DataContext="{x:Static services:DialogService.Current}"
      Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</ui:FluentWindow>
