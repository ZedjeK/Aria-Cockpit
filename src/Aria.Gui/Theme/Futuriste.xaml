<!--
  Thème « cockpit HUD », palette Glace : cyan glacé, bleu roi, blanc et orange.
  Toutes les pages s'appuient sur ces couleurs et ces styles.
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Palette ===== -->
  <Color x:Key="NeonOrangeColor">#FFFF8A1F</Color>
  <Color x:Key="NeonCyanColor">#FF7DF9FF</Color>
  <Color x:Key="NeonBlueColor">#FF5C8BFF</Color>
  <Color x:Key="NeonRedColor">#FFFF3D5A</Color>
  <!-- « Positif / conforme » : cyan glacé, comme le reste de la palette -->
  <Color x:Key="NeonTealColor">#FF7DF9FF</Color>
  <!-- Succès (« appliqué », « installé ») : cyan glacé, comme « conforme » -->
  <Color x:Key="NeonGreenColor">#FF7DF9FF</Color>
  <Color x:Key="DeepSpaceColor">#FF030812</Color>
  <Color x:Key="PanelColor">#B30A1428</Color>
  <Color x:Key="PanelHoverColor">#D90F1C36</Color>

  <SolidColorBrush x:Key="NeonOrangeBrush" Color="{StaticResource NeonOrangeColor}" />
  <SolidColorBrush x:Key="NeonCyanBrush" Color="{StaticResource NeonCyanColor}" />
  <SolidColorBrush x:Key="NeonBlueBrush" Color="{StaticResource NeonBlueColor}" />
  <SolidColorBrush x:Key="NeonBlueLightBrush" Color="#FF8FAEFF" />
  <SolidColorBrush x:Key="NeonRedBrush" Color="{StaticResource NeonRedColor}" />
  <SolidColorBrush x:Key="NeonTealBrush" Color="{StaticResource NeonTealColor}" />
  <SolidColorBrush x:Key="NeonGreenBrush" Color="{StaticResource NeonGreenColor}" />
  <SolidColorBrush x:Key="NeonTextBrush" Color="#FFE6F4FF" />
  <SolidColorBrush x:Key="NeonWhiteBrush" Color="#FFEFFFFF" />
  <SolidColorBrush x:Key="NeonMutedBrush" Color="#FF8FA6C4" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />

  <!-- Couleurs des pastilles de diagnostic -->
  <SolidColorBrush x:Key="SeverityCriticalBrush" Color="{StaticResource NeonRedColor}" />
  <SolidColorBrush x:Key="SeverityWarningBrush" Color="{StaticResource NeonOrangeColor}" />
  <SolidColorBrush x:Key="SeverityInfoBrush" Color="{StaticResource NeonBlueColor}" />
  <SolidColorBrush x:Key="SeverityOkBrush" Color="{StaticResource NeonTealColor}" />

  <!-- Dégradés -->
  <LinearGradientBrush x:Key="NeonGradientBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="{StaticResource NeonOrangeColor}" />
    <GradientStop Offset="1" Color="{StaticResource NeonCyanColor}" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="NeonBorderBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#B35C8BFF" />
    <GradientStop Offset="0.45" Color="#267DF9FF" />
    <GradientStop Offset="1" Color="#B37DF9FF" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="NeonLineBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#997DF9FF" />
    <GradientStop Offset="1" Color="#007DF9FF" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#405C8BFF" />
    <GradientStop Offset="0.5" Color="#100A1428" />
    <GradientStop Offset="1" Color="#2A7DF9FF" />
  </LinearGradientBrush>

  <!-- Fond de la fenêtre : espace profond + grille lumineuse -->
  <LinearGradientBrush x:Key="SpaceBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FF030812" />
    <GradientStop Offset="0.55" Color="#FF061026" />
    <GradientStop Offset="1" Color="#FF030812" />
  </LinearGradientBrush>

  <DrawingBrush
    x:Key="GridBrush"
    TileMode="Tile"
    Viewbox="0,0,40,40"
    ViewboxUnits="Absolute"
    Viewport="0,0,40,40"
    ViewportUnits="Absolute">
    <DrawingBrush.Drawing>
      <GeometryDrawing>
        <GeometryDrawing.Pen>
          <Pen Brush="#107DF9FF" Thickness="1" />
        </GeometryDrawing.Pen>
        <GeometryDrawing.Geometry>
          <GeometryGroup>
            <LineGeometry StartPoint="0,0" EndPoint="40,0" />
            <LineGeometry StartPoint="0,0" EndPoint="0,40" />
          </GeometryGroup>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- ===== Polices ===== -->
  <!-- Bahnschrift est installée sur tous les Windows 10 et 11 : rendu « affichage de bord » -->
  <FontFamily x:Key="TechFont">Bahnschrift, Segoe UI</FontFamily>
  <!--
    Consolas d'abord : police du dossier Windows, toujours présente. Cascadia Mono peut être fournie par
    Terminal Windows et disparaître pendant sa mise à jour (cause du plantage du 08/10/2026).
  -->
  <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Courier New</FontFamily>

  <!-- ===== Styles ===== -->

  <!-- Titre : blanc glacé avec un halo cyan, comme un tube néon -->
  <Style x:Key="NeonTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TechFont}" />
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource NeonWhiteBrush}" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="16" Opacity="0.6" ShadowDepth="0" Color="{StaticResource NeonCyanColor}" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Petite étiquette technique en majuscules -->
  <Style x:Key="TechLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TechFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource NeonMutedBrush}" />
  </Style>

  <!-- Titre de section façon HUD : repère orange lumineux, texte cyan, ligne qui s'estompe -->
  <Style x:Key="SectionHeader" TargetType="ContentControl">
    <Setter Property="Margin" Value="0,30,0,12" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle
              Width="4"
              Height="14"
              Margin="0,0,10,0"
              VerticalAlignment="Center"
              Fill="{StaticResource NeonOrangeBrush}">
              <Rectangle.Effect>
                <DropShadowEffect BlurRadius="8" Opacity="0.9" ShadowDepth="0" Color="{StaticResource NeonOrangeColor}" />
              </Rectangle.Effect>
            </Rectangle>
            <ContentPresenter
              Grid.Column="1"
              VerticalAlignment="Center"
              TextElement.FontFamily="{StaticResource TechFont}"
              TextElement.FontSize="15"
              TextElement.FontWeight="SemiBold"
              TextElement.Foreground="{StaticResource NeonCyanBrush}" />
            <Rectangle
              Grid.Column="2"
              Height="1"
              Margin="14,0,0,0"
              VerticalAlignment="Center"
              Fill="{StaticResource NeonLineBrush}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Panneau néon, version cockpit : angles droits, fin liseré cyan, deux coins de viseur lumineux
    (haut gauche, bas droite) et halo discret qui s'allume au survol. Utilisé par toutes les pages.
  -->
  <Style x:Key="NeonPanel" TargetType="ContentControl">
    <Setter Property="Padding" Value="18" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{StaticResource NeonTextBrush}" />
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <!-- Halo séparé du contenu : le texte reste net -->
            <Border x:Name="Glow" Background="{TemplateBinding Background}">
              <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.12" ShadowDepth="0" Color="{StaticResource NeonCyanColor}" />
              </Border.Effect>
            </Border>
            <Border
              x:Name="Frame"
              Padding="{TemplateBinding Padding}"
              BorderBrush="#2E7DF9FF"
              BorderThickness="1">
              <ContentPresenter />
            </Border>
            <Path
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Data="M0,14 L0,0 L14,0"
              IsHitTestVisible="False"
              Stroke="{StaticResource NeonCyanBrush}"
              StrokeThickness="2" />
            <Path
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Data="M0,14 L14,14 L14,0"
              IsHitTestVisible="False"
              Stroke="{StaticResource NeonCyanBrush}"
              StrokeThickness="2" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="#557DF9FF" />
              <Setter TargetName="Glow" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="26" Opacity="0.28" ShadowDepth="0" Color="{StaticResource NeonCyanColor}" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pastille d'icône lumineuse -->
  <Style x:Key="IconBadge" TargetType="Border">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#99FF8A1F" />
    <Setter Property="Background">
      <Setter.Value>
        <RadialGradientBrush>
          <GradientStop Offset="0" Color="#55FF8A1F" />
          <GradientStop Offset="1" Color="#00FF8A1F" />
        </RadialGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="14" Opacity="0.55" ShadowDepth="0" Color="{StaticResource NeonOrangeColor}" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Grand chiffre de tableau de bord -->
  <Style x:Key="StatValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TechFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Étiquettes (« REDÉMARRAGE », « CONFORT »…) : orange pour un redémarrage, rouge pour une prudence, cyan glacé pour du positif, bleu roi sinon.
       DataContext : un Badge (propriété Kind). -->
  <Style x:Key="BadgeBorder" TargetType="Border">
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBrush}" />
    <Setter Property="Background" Value="#1A5C8BFF" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Kind}" Value="Reboot">
        <Setter Property="BorderBrush" Value="{StaticResource NeonOrangeBrush}" />
        <Setter Property="Background" Value="#1AFF8A1F" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Caution">
        <Setter Property="BorderBrush" Value="{StaticResource NeonRedBrush}" />
        <Setter Property="Background" Value="#1AFF3D5A" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Good">
        <Setter Property="BorderBrush" Value="{StaticResource NeonTealBrush}" />
        <Setter Property="Background" Value="#1A7DF9FF" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="BadgeText" BasedOn="{StaticResource TechLabel}" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource NeonBlueLightBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Kind}" Value="Reboot">
        <Setter Property="Foreground" Value="{StaticResource NeonOrangeBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Caution">
        <Setter Property="Foreground" Value="{StaticResource NeonRedBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Good">
        <Setter Property="Foreground" Value="{StaticResource NeonTealBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Cockpit HUD ===== -->

  <!--
    Panneau de viseur : fond nuit translucide, fin liseré et deux coins lumineux (haut gauche, bas droite).
    BorderBrush = couleur des coins.
  -->
  <Style x:Key="HudPanel" TargetType="ContentControl">
    <Setter Property="Padding" Value="20,16" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{StaticResource NeonTextBrush}" />
    <Setter Property="Background" Value="#B3050E20" />
    <Setter Property="BorderBrush" Value="{StaticResource NeonCyanBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border
              x:Name="Body"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="#1F7DF9FF"
              BorderThickness="1">
              <ContentPresenter />
            </Border>
            <Path
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Data="M0,16 L0,0 L16,0"
              Stroke="{TemplateBinding BorderBrush}"
              StrokeThickness="2">
              <Path.Effect>
                <DropShadowEffect BlurRadius="8" Opacity="0.8" ShadowDepth="0" Color="{StaticResource NeonCyanColor}" />
              </Path.Effect>
            </Path>
            <Path
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Data="M0,16 L16,16 L16,0"
              Stroke="{TemplateBinding BorderBrush}"
              StrokeThickness="2">
              <Path.Effect>
                <DropShadowEffect BlurRadius="8" Opacity="0.8" ShadowDepth="0" Color="{StaticResource NeonCyanColor}" />
              </Path.Effect>
            </Path>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="BorderBrush" Value="#407DF9FF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Même panneau, coins en miroir (haut droite, bas gauche) : pour la colonne de droite du cockpit -->
  <Style x:Key="HudPanelMirror" BasedOn="{StaticResource HudPanel}" TargetType="ContentControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border
              x:Name="Body"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="#1F7DF9FF"
              BorderThickness="1">
              <ContentPresenter />
            </Border>
            <Path
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Data="M0,0 L16,0 L16,16"
              Stroke="{TemplateBinding BorderBrush}"
              StrokeThickness="2">
              <Path.Effect>
                <DropShadowEffect BlurRadius="8" Opacity="0.8" ShadowDepth="0" Color="{StaticResource NeonCyanColor}" />
              </Path.Effect>
            </Path>
            <Path
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              Data="M0,0 L0,16 L16,16"
              Stroke="{TemplateBinding BorderBrush}"
              StrokeThickness="2">
              <Path.Effect>
                <DropShadowEffect BlurRadius="8" Opacity="0.8" ShadowDepth="0" Color="{StaticResource NeonCyanColor}" />
              </Path.Effect>
            </Path>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="BorderBrush" Value="#407DF9FF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Formes des boutons biseautés : dessinées en fond (pinceau étiré), elles ne pèsent pas sur la taille
    du bouton, qui suit son texte. Une forme posée comme élément étiré prendrait toute la largeur disponible.
  -->
  <DrawingBrush x:Key="HudOrangeShape" Stretch="Fill">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="{StaticResource NeonOrangeBrush}" Geometry="M10,0 L100,0 L90,40 L0,40 Z" />
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <DrawingBrush x:Key="HudGhostShape" Stretch="Fill">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="#1F7DF9FF" Geometry="M10,0 L100,0 L90,40 L0,40 Z">
        <GeometryDrawing.Pen>
          <Pen Brush="#997DF9FF" Thickness="1" />
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Bouton biseauté (parallélogramme) : orange plein pour l'action principale -->
  <Style x:Key="HudButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource HudOrangeShape}" />
    <Setter Property="Foreground" Value="#FF1A0B00" />
    <Setter Property="FontFamily" Value="{StaticResource TechFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="28,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Border x:Name="Shape" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
              <ContentPresenter
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RecognizesAccessKey="True" />
            </Border>
            <Rectangle
              x:Name="Focus"
              Margin="-3"
              Stroke="{StaticResource NeonCyanBrush}"
              StrokeDashArray="2 2"
              StrokeThickness="1"
              Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shape" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="16" Opacity="0.7" ShadowDepth="0" Color="{StaticResource NeonOrangeColor}" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Bouton biseauté secondaire : verre cyan -->
  <Style x:Key="HudButtonGhost" BasedOn="{StaticResource HudButton}" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource HudGhostShape}" />
    <Setter Property="Foreground" Value="{StaticResource NeonWhiteBrush}" />
  </Style>

  <!--
    Bloc résumé cliquable du cockpit (« à corriger », « pour info », « conformes ») :
    fond teinté, liseré et coin lumineux de la couleur du bloc (BorderBrush).
  -->
  <Style x:Key="HudStat" TargetType="Button">
    <Setter Property="Padding" Value="20,16" />
    <Setter Property="Foreground" Value="{StaticResource NeonTextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border
              x:Name="Body"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="1"
              Opacity="1">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <Path
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Data="M0,0 L16,0 L16,16"
              Stroke="{TemplateBinding BorderBrush}"
              StrokeThickness="3" />
            <Rectangle
              x:Name="Focus"
              Margin="-4"
              Stroke="{StaticResource NeonCyanBrush}"
              StrokeDashArray="2 2"
              StrokeThickness="1"
              Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="18" Opacity="0.35" ShadowDepth="0" Color="{StaticResource NeonCyanColor}" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Repère technique en police mono (« 01 · PROCESSEUR ») -->
  <Style x:Key="HudCode" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource NeonOrangeBrush}" />
  </Style>

  <!-- Onglet de la barre du haut : texte en majuscules, souligné orange lumineux quand il est actif -->
  <Style x:Key="HudTab" TargetType="RadioButton">
    <Setter Property="GroupName" Value="Navigation" />
    <Setter Property="Foreground" Value="{StaticResource NeonMutedBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource TechFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent">
            <Rectangle x:Name="Glow" Opacity="0">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                  <GradientStop Offset="0" Color="#33FF8A1F" />
                  <GradientStop Offset="0.75" Color="#00FF8A1F" />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <ContentPresenter
              Margin="15,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RecognizesAccessKey="True" />
            <Rectangle
              x:Name="Underline"
              Height="3"
              VerticalAlignment="Bottom"
              Fill="{StaticResource NeonOrangeBrush}"
              Opacity="0">
              <Rectangle.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.9" ShadowDepth="0" Color="{StaticResource NeonOrangeColor}" />
              </Rectangle.Effect>
            </Rectangle>
            <Rectangle
              x:Name="Focus"
              Margin="6,10"
              RadiusX="4"
              RadiusY="4"
              Stroke="{StaticResource NeonCyanBrush}"
              StrokeDashArray="2 2"
              StrokeThickness="1"
              Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource NeonWhiteBrush}" />
              <Setter TargetName="Underline" Property="Opacity" Value="1" />
              <Setter TargetName="Glow" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
