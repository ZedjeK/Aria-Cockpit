<!--
  Logo d'Aria Cockpit en vectoriel (même dessin que Assets/logo.svg) : plaque à coins coupés,
  A en tubes néon dont le sommet est décalé (glitch), compteur orange au pied du A.
  Les halos sont posés sur des Canvas parents pour ne pas être coupés par les découpes du glitch.
-->
<UserControl
  x:Class="Aria.Gui.Views.AriaLogo"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Focusable="False"
  IsHitTestVisible="False">
  <Viewbox Stretch="Uniform">
    <Canvas Width="160" Height="160">
      <Polygon Fill="#FF030812" Points="24,0 136,0 160,24 160,136 136,160 24,160 0,136 0,24" />
      <Polygon
        Points="26,7 134,7 153,26 153,134 134,153 26,153 7,134 7,26"
        Stroke="#A64D7CFF"
        StrokeThickness="2.5" />

      <!-- Jambe gauche : cyan glacé -->
      <Canvas>
        <Canvas.Effect>
          <DropShadowEffect BlurRadius="12" Opacity="0.9" ShadowDepth="0" Color="#FF7DF9FF" />
        </Canvas.Effect>
        <Path
          Data="M30,130 L70,30 L90,30 L130,130 L110,130 L80,54 L50,130 Z"
          Stroke="#FF7DF9FF"
          StrokeLineJoin="Round"
          StrokeThickness="6">
          <Path.Clip>
            <RectangleGeometry Rect="0,72,80,90" />
          </Path.Clip>
        </Path>
      </Canvas>

      <!-- Jambe droite : bleu roi -->
      <Canvas>
        <Canvas.Effect>
          <DropShadowEffect BlurRadius="12" Opacity="0.9" ShadowDepth="0" Color="#FF5C8BFF" />
        </Canvas.Effect>
        <Path
          Data="M30,130 L70,30 L90,30 L130,130 L110,130 L80,54 L50,130 Z"
          Stroke="#FF5C8BFF"
          StrokeLineJoin="Round"
          StrokeThickness="6">
          <Path.Clip>
            <RectangleGeometry Rect="80,72,80,90" />
          </Path.Clip>
        </Path>
      </Canvas>

      <!-- Sommet blanc, décalé vers la droite : le glitch -->
      <Canvas>
        <Canvas.Effect>
          <DropShadowEffect BlurRadius="12" Opacity="0.8" ShadowDepth="0" Color="#FFFFFFFF" />
        </Canvas.Effect>
        <Path
          Data="M30,130 L70,30 L90,30 L130,130 L110,130 L80,54 L50,130 Z"
          Stroke="#FFFFFFFF"
          StrokeLineJoin="Round"
          StrokeThickness="6">
          <Path.Clip>
            <RectangleGeometry Rect="0,0,160,72" />
          </Path.Clip>
          <Path.RenderTransform>
            <TranslateTransform X="7" />
          </Path.RenderTransform>
        </Path>
      </Canvas>

      <!-- Compteur orange : l'emblème d'Aria Cockpit -->
      <Canvas>
        <Canvas.Effect>
          <DropShadowEffect BlurRadius="12" Opacity="0.9" ShadowDepth="0" Color="#FFFF8A1F" />
        </Canvas.Effect>
        <Path Data="M58,114 A22,22 0 0 1 102,114 Z" Fill="#FFFF8A1F" />
        <Path Data="M65,114 A15,15 0 0 1 95,114 Z" Fill="#FF030812" Opacity="0.85" />
        <Polygon Fill="#FFFF8A1F" Points="78.5,113 81.5,115 93,98" />
        <Ellipse Canvas.Left="76" Canvas.Top="110" Width="8" Height="8" Fill="#FFFF8A1F" />
        <Rectangle Canvas.Left="58" Canvas.Top="115" Width="44" Height="5" Fill="#FFFF8A1F" RadiusX="2" RadiusY="2" />
      </Canvas>
    </Canvas>
  </Viewbox>
</UserControl>
