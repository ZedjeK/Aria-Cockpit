<!-- Liste à cocher néon, partagée par les pages Réglages, Mises à jour et Restauration. DataContext : liste de CheckGroup. -->
<UserControl
  x:Class="Aria.Gui.Views.ChecklistView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fx="clr-namespace:Aria.Gui.Effects">
  <UserControl.Resources>
    <!-- Ligne décochée : atténuée -->
    <Style x:Key="RowDim" TargetType="Grid">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="False">
          <Setter Property="Opacity" Value="0.5" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <ItemsControl ItemsSource="{Binding}">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <StackPanel Margin="0,0,0,16">
          <!-- Case de groupe : tout cocher / tout décocher -->
          <CheckBox Margin="4,0,0,10" IsChecked="{Binding AllSelected}">
            <TextBlock
              Margin="4,0,0,0"
              Foreground="{StaticResource NeonCyanBrush}"
              Style="{StaticResource TechLabel}"
              Text="{Binding Header}" />
          </CheckBox>

          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ContentControl
                  Margin="0,0,0,8"
                  Padding="16,12"
                  fx:Fx.Reveal="True"
                  Style="{StaticResource NeonPanel}">
                  <Grid Style="{StaticResource RowDim}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Toute la zone de texte coche/décoche la ligne -->
                    <CheckBox
                      Grid.Column="0"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Center"
                      IsChecked="{Binding IsSelected}">
                      <StackPanel Margin="6,0,18,0">
                        <TextBlock
                          FontFamily="{StaticResource TechFont}"
                          FontSize="16"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource NeonTextBrush}"
                          Text="{Binding Title}"
                          TextWrapping="Wrap" />
                        <TextBlock
                          Margin="0,3,0,0"
                          Foreground="{StaticResource NeonMutedBrush}"
                          Text="{Binding Reason}"
                          TextWrapping="Wrap" />
                      </StackPanel>
                    </CheckBox>

                    <!-- Actuel → Cible -->
                    <StackPanel Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center" Orientation="Horizontal">
                      <TextBlock
                        FontFamily="{StaticResource MonoFont}"
                        Foreground="{StaticResource NeonMutedBrush}"
                        Text="{Binding From}"
                        Visibility="{Binding HasFrom, Converter={StaticResource BoolToVisibility}}" />
                      <TextBlock
                        Margin="10,0"
                        FontFamily="{StaticResource TechFont}"
                        FontWeight="Bold"
                        Foreground="{StaticResource NeonOrangeBrush}"
                        Text="→"
                        Visibility="{Binding HasFrom, Converter={StaticResource BoolToVisibility}}" />
                      <TextBlock
                        FontFamily="{StaticResource MonoFont}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NeonCyanBrush}"
                        Text="{Binding To}"
                        Visibility="{Binding HasTo, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <ItemsControl Grid.Column="2" VerticalAlignment="Center" ItemsSource="{Binding Badges}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource BadgeBorder}">
                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Text}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </ContentControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
