<Page
  x:Class="Aria.Gui.Views.CleanupPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fx="clr-namespace:Aria.Gui.Effects"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:views="clr-namespace:Aria.Gui.Views"
  Title="Nettoyage"
  Foreground="{StaticResource NeonTextBrush}"
  Loaded="OnLoaded"
  ScrollViewer.CanContentScroll="False">
  <!-- CanContentScroll=False : la page gère son propre défilement, pour garder la barre d'action fixe en bas -->
  <Page.Resources>
    <fx:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <DataTemplate x:Key="SimpleRowTemplate">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
        <TextBlock
          Grid.Column="1"
          Margin="16,0,0,0"
          FontFamily="{StaticResource MonoFont}"
          Foreground="{StaticResource NeonTealBrush}"
          Text="{Binding Value}" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <!-- ================= Liste ================= -->
    <Grid Visibility="{Binding ShowResults, Converter={StaticResource InverseBoolToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1500" Margin="36,24,36,24">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0">
              <TextBlock Margin="0,0,0,2" Style="{StaticResource HudCode}" Text="05 · ESPACE DISQUE" />
              <TextBlock Style="{StaticResource NeonTitle}" Text="NETTOYAGE" />
              <TextBlock
                Margin="0,4,0,0"
                Foreground="{StaticResource NeonMutedBrush}"
                Text="{Binding ScanText}"
                TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
              <ui:Button Margin="0,0,8,0" Command="{Binding SelectAllCommand}" Content="Tout cocher" Icon="{ui:SymbolIcon CheckboxChecked24}" />
              <ui:Button Margin="0,0,8,0" Command="{Binding SelectNoneCommand}" Content="Tout décocher" Icon="{ui:SymbolIcon CheckboxUnchecked24}" />
              <ui:Button Command="{Binding ScanCommand}" Content="Réanalyser" Icon="{ui:SymbolIcon ArrowClockwise24}" />
            </StackPanel>
          </Grid>

          <ContentControl Content="ESPACE RÉCUPÉRABLE" Style="{StaticResource SectionHeader}" />

          <views:ChecklistView DataContext="{Binding Groups}" Visibility="{Binding DataContext.HasItems, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}" />

          <!-- Rien à nettoyer -->
          <ContentControl fx:Fx.Reveal="True" Style="{StaticResource NeonPanel}">
            <ContentControl.Visibility>
              <MultiBinding Converter="{x:Static views:CleanupPage.BothTrue}">
                <Binding Path="HasNothing" />
                <Binding Path="HasScanned" />
              </MultiBinding>
            </ContentControl.Visibility>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon FontSize="26" Foreground="{StaticResource NeonGreenBrush}" Symbol="CheckmarkCircle24" />
              <StackPanel Margin="14,0,0,0">
                <TextBlock FontFamily="{StaticResource TechFont}" FontSize="17" FontWeight="SemiBold" Text="Rien à nettoyer." />
                <TextBlock Foreground="{StaticResource NeonMutedBrush}" Text="Le PC est déjà propre." />
              </StackPanel>
            </StackPanel>
          </ContentControl>

          <ui:CardExpander
            Margin="0,8,0,8"
            Header="{Binding EmptyHeader}"
            Visibility="{Binding HasEmpty, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemTemplate="{StaticResource SimpleRowTemplate}" ItemsSource="{Binding Empty}" />
          </ui:CardExpander>

          <!-- Rappel de sécurité -->
          <ContentControl Margin="0,16,0,0" Style="{StaticResource NeonPanel}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon FontSize="22" Foreground="{StaticResource NeonOrangeBrush}" Symbol="Warning24" />
              <TextBlock
                Margin="14,0,0,0"
                VerticalAlignment="Center"
                Foreground="{StaticResource NeonMutedBrush}"
                Text="Aria ne touche qu'à ces emplacements précis, jamais à vos documents ni à la corbeille. Une suppression est définitive : elle ne peut pas être annulée par une restauration."
                TextWrapping="Wrap" />
            </StackPanel>
          </ContentControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Barre d'action -->
      <Border
        Grid.Row="1"
        Padding="36,14"
        Background="#E6070B14"
        BorderBrush="{StaticResource NeonLineBrush}"
        BorderThickness="0,1,0,0"
        Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
        <Grid MaxWidth="1500">
          <StackPanel VerticalAlignment="Center">
            <TextBlock
              FontFamily="{StaticResource TechFont}"
              FontSize="16"
              FontWeight="SemiBold"
              Text="{Binding SelectionText}" />
            <TextBlock Foreground="{StaticResource NeonMutedBrush}" Text="Une confirmation récapitule tout avant la suppression." />
          </StackPanel>
          <Button
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding CleanCommand}"
            Content="{Binding CleanText}" Style="{StaticResource HudButton}" />
        </Grid>
      </Border>
    </Grid>

    <!-- ================= Résultat ================= -->
    <views:ChangeResultView Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibility}}" />

    <!-- ================= Analyse ou nettoyage en cours ================= -->
    <views:ApplyingOverlay Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</Page>
