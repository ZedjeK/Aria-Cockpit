<!-- Confirmation intégrée à la fenêtre : voile sombre + panneau néon. DataContext : DialogService. -->
<UserControl
  x:Class="Aria.Gui.Views.DialogOverlay"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Focusable="False"
  KeyboardNavigation.TabNavigation="Cycle"
  PreviewKeyDown="OnPreviewKeyDown">
  <!-- Le voile capte les clics : rien n'est cliquable derrière -->
  <Grid Background="#D9030812">
    <ContentControl
      x:Name="Panel"
      MinWidth="460"
      MaxWidth="760"
      Margin="40"
      Padding="0"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      RenderTransformOrigin="0.5,0.5"
      Style="{StaticResource NeonPanel}">
      <ContentControl.RenderTransform>
        <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1" />
      </ContentControl.RenderTransform>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Padding="24,20,24,14" BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource IconBadge}">
              <ui:SymbolIcon
                x:Name="HeaderIcon"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                Foreground="{StaticResource NeonOrangeBrush}"
                Symbol="ShieldCheckmark24" />
            </Border>
            <TextBlock
              Margin="14,0,0,0"
              VerticalAlignment="Center"
              FontSize="22"
              Style="{StaticResource NeonTitle}"
              Text="{Binding Title}"
              TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Contenu, défilant si la liste est longue -->
        <ScrollViewer
          Grid.Row="1"
          MaxHeight="440"
          Padding="24,16,24,8"
          VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock
              Margin="0,0,0,12"
              FontSize="15"
              Text="{Binding Message}"
              TextWrapping="Wrap"
              Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />

            <!-- Changements : nom à gauche, avant → après aligné à droite -->
            <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding Rows}" Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border
                    Padding="0,7"
                    BorderBrush="#1F7DF9FF"
                    BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource TechFont}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Binding Name}"
                        TextWrapping="Wrap" />
                      <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                          FontFamily="{StaticResource MonoFont}"
                          Foreground="{StaticResource NeonMutedBrush}"
                          Text="{Binding From}"
                          Visibility="{Binding HasFrom, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                          Margin="8,0"
                          FontWeight="Bold"
                          Foreground="{StaticResource NeonOrangeBrush}"
                          Text="→"
                          Visibility="{Binding HasFrom, Converter={StaticResource BoolToVisibility}}" />
                        <!-- Largeur bornée : un texte long revient à la ligne au lieu de pousser le nom hors de la fenêtre -->
                        <TextBlock
                          MaxWidth="400"
                          FontFamily="{StaticResource MonoFont}"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource NeonCyanBrush}"
                          Text="{Binding To}"
                          TextAlignment="Right"
                          TextWrapping="Wrap"
                          Visibility="{Binding HasTo, Converter={StaticResource BoolToVisibility}}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Points d'attention -->
            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Warnings}" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                      Margin="0,1,10,0"
                      VerticalAlignment="Top"
                      FontSize="16"
                      Foreground="{StaticResource NeonOrangeBrush}"
                      Symbol="Warning24" />
                    <TextBlock Grid.Column="1" Foreground="{StaticResource NeonOrangeBrush}" Text="{Binding}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
              Margin="0,12,0,4"
              Foreground="{StaticResource NeonMutedBrush}"
              Text="{Binding Note}"
              TextWrapping="Wrap"
              Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </ScrollViewer>

        <!-- Boutons -->
        <Border
          Grid.Row="2"
          Padding="24,14,24,20"
          BorderBrush="{StaticResource NeonLineBrush}"
          BorderThickness="0,1,0,0">
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
              x:Name="CancelButton"
              Margin="0,0,10,0"
              MinWidth="120"
              Command="{Binding CancelCommand}"
              Content="{Binding CancelText}"
              Style="{StaticResource HudButtonGhost}"
              Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}" />
            <Button
              x:Name="ConfirmButton"
              MinWidth="150"
              Command="{Binding ConfirmCommand}"
              Content="{Binding ConfirmText}" Style="{StaticResource HudButton}" />
          </StackPanel>
        </Border>
      </Grid>
    </ContentControl>
  </Grid>
</UserControl>
