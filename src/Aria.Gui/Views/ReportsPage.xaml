<Page
  x:Class="Aria.Gui.Views.ReportsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fx="clr-namespace:Aria.Gui.Effects"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Rapports"
  Foreground="{StaticResource NeonTextBrush}"
  Loaded="OnLoaded"
  ScrollViewer.CanContentScroll="False">
  <!-- CanContentScroll=False : la liste et l'aperçu ont chacun leur défilement, la page occupe toute la hauteur -->
  <Page.Resources>
    <!-- Carte de rapport : panneau néon, bordure orange lumineuse une fois choisie -->
    <Style x:Key="ReportItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,10,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{StaticResource NeonTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="Glow" Background="{StaticResource PanelBrush}" CornerRadius="2">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="18" Opacity="0.12" ShadowDepth="0" Color="{StaticResource NeonCyanColor}" />
                </Border.Effect>
              </Border>
              <Border
                x:Name="Frame"
                Padding="14,11"
                BorderBrush="{StaticResource NeonBorderBrush}"
                BorderThickness="1"
                CornerRadius="2">
                <ContentPresenter />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glow" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="24" Opacity="0.3" ShadowDepth="0" Color="{StaticResource NeonOrangeColor}" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource NeonOrangeBrush}" />
                <Setter TargetName="Glow" Property="Background" Value="#26FF8A1F" />
                <Setter TargetName="Glow" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="26" Opacity="0.5" ShadowDepth="0" Color="{StaticResource NeonOrangeColor}" />
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid MaxWidth="1500" Margin="36,24,36,28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- En-tête -->
    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,24,0">
        <TextBlock Margin="0,0,0,2" Style="{StaticResource HudCode}" Text="06 · JOURNAL DES OPÉRATIONS" />
        <TextBlock Style="{StaticResource NeonTitle}" Text="RAPPORTS" />
        <TextBlock
          Margin="0,4,0,0"
          Foreground="{StaticResource NeonMutedBrush}"
          Text="Chaque application de réglages, restauration, mise à jour ou nettoyage laisse un rapport détaillé. La fiche PC résume tout en une page HTML."
          TextWrapping="Wrap" />
        <TextBlock
          Margin="0,2,0,0"
          FontFamily="{StaticResource MonoFont}"
          Foreground="{StaticResource NeonTealBrush}"
          Text="{Binding Folder, Mode=OneTime}"
          TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <ui:Button Margin="0,0,8,0" Command="{Binding RefreshCommand}" Content="Actualiser" Icon="{ui:SymbolIcon ArrowClockwise24}" />
          <ui:Button Margin="0,0,8,0" Command="{Binding OpenFolderCommand}" Content="Ouvrir le dossier" Icon="{ui:SymbolIcon FolderOpen24}" />
          <Button
            Command="{Binding ExportHtmlCommand}"
            Content="Exporter la fiche PC"
            ToolTip="Fiche complète du PC en HTML, à partager ou imprimer" Style="{StaticResource HudButton}" />
        </StackPanel>
        <CheckBox
          Margin="0,10,0,0"
          HorizontalAlignment="Right"
          Content="Masquer les infos personnelles dans la fiche"
          Foreground="{StaticResource NeonMutedBrush}"
          IsChecked="{Binding HidePersonalInfo}" />
      </StackPanel>
    </Grid>

    <!-- Liste + aperçu -->
    <Grid Grid.Row="1" Visibility="{Binding HasReports, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel>
        <TextBlock
          Margin="2,0,0,10"
          DockPanel.Dock="Top"
          Foreground="{StaticResource NeonCyanBrush}"
          Style="{StaticResource TechLabel}"
          Text="{Binding CountText}" />
        <ListBox
          Padding="0"
          Background="Transparent"
          BorderThickness="0"
          ItemContainerStyle="{StaticResource ReportItem}"
          ItemsSource="{Binding Reports}"
          ScrollViewer.CanContentScroll="False"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          SelectedItem="{Binding Selected, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <Grid>
                  <Border
                    Margin="0"
                    HorizontalAlignment="Left"
                    DataContext="{Binding Badge}"
                    Style="{StaticResource BadgeBorder}">
                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Text}" />
                  </Border>
                  <TextBlock
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource MonoFont}"
                    Foreground="{StaticResource NeonMutedBrush}"
                    Text="{Binding Date}" />
                </Grid>
                <TextBlock
                  Margin="0,7,0,0"
                  Foreground="{StaticResource NeonTextBrush}"
                  Text="{Binding Summary}"
                  TextWrapping="Wrap"
                  Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Aperçu du rapport choisi -->
      <ContentControl
        Grid.Column="1"
        Margin="12,0,0,0"
        Padding="0"
        Style="{StaticResource NeonPanel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border
            Padding="18,12"
            BorderBrush="{StaticResource NeonLineBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
              <TextBlock
                VerticalAlignment="Center"
                Foreground="{StaticResource NeonCyanBrush}"
                Style="{StaticResource TechLabel}"
                Text="APERÇU" />
              <Button
                HorizontalAlignment="Right"
                Command="{Binding OpenSelectedCommand}"
                Content="Ouvrir" Style="{StaticResource HudButton}" />
            </Grid>
          </Border>
          <TextBox
            Grid.Row="1"
            Margin="6"
            Padding="12,8"
            Background="Transparent"
            BorderThickness="0"
            FontFamily="{StaticResource MonoFont}"
            FontSize="13"
            Foreground="{StaticResource NeonTextBrush}"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="True"
            Text="{Binding Preview, Mode=OneWay}"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto" />
        </Grid>
      </ContentControl>
    </Grid>

    <!-- Aucun rapport -->
    <ContentControl
      Grid.Row="1"
      VerticalAlignment="Top"
      fx:Fx.Reveal="True"
      Style="{StaticResource NeonPanel}"
      Visibility="{Binding HasNoReports, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon FontSize="26" Foreground="{StaticResource NeonCyanBrush}" Symbol="Info24" />
        <StackPanel Margin="14,0,0,0">
          <TextBlock FontFamily="{StaticResource TechFont}" FontSize="17" FontWeight="SemiBold" Text="Aucun rapport pour le moment." />
          <TextBlock Foreground="{StaticResource NeonMutedBrush}" Text="Un rapport est enregistré après chaque application de réglages, restauration ou série de mises à jour." TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ContentControl>
  </Grid>
</Page>
