<Page
  x:Class="Aria.Gui.Views.RestorePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fx="clr-namespace:Aria.Gui.Effects"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:views="clr-namespace:Aria.Gui.Views"
  Title="Restauration"
  Foreground="{StaticResource NeonTextBrush}"
  Loaded="OnLoaded"
  ScrollViewer.CanContentScroll="False">
  <!-- CanContentScroll=False : la page gère son propre défilement, pour garder la barre d'action fixe en bas -->
  <Page.Resources>
    <!-- Ligne « nom : valeur » des sections repliables -->
    <DataTemplate x:Key="SimpleRowTemplate">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
        <TextBlock
          Grid.Column="1"
          Margin="16,0,0,0"
          FontFamily="{StaticResource MonoFont}"
          Foreground="{StaticResource NeonTealBrush}"
          Text="{Binding Value}"
          TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <!-- ================= Liste des sauvegardes ================= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
      <StackPanel MaxWidth="1500" Margin="36,24,36,36">
        <Grid>
          <StackPanel Margin="0,0,140,0">
            <TextBlock Margin="0,0,0,2" Style="{StaticResource HudCode}" Text="05 · SAUVEGARDES" />
            <TextBlock Style="{StaticResource NeonTitle}" Text="RESTAURATION" />
            <TextBlock
              Margin="0,4,0,0"
              Foreground="{StaticResource NeonMutedBrush}"
              Text="Revenir aux valeurs enregistrées avant une modification. Une sauvegarde est créée automatiquement avant chaque changement."
              TextWrapping="Wrap" />
          </StackPanel>
          <ui:Button
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding RefreshCommand}"
            Content="Actualiser"
            Icon="{ui:SymbolIcon ArrowClockwise24}" />
        </Grid>

        <ui:InfoBar
          Title="Restauration impossible"
          Margin="0,18,0,0"
          IsClosable="False"
          IsOpen="{Binding HasError, Mode=OneWay}"
          Message="{Binding Error}"
          Severity="Error" />

        <ContentControl Content="SAUVEGARDES" Style="{StaticResource SectionHeader}" />

        <ItemsControl ItemsSource="{Binding Backups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ContentControl Margin="0,0,0,10" fx:Fx.Reveal="True" Style="{StaticResource NeonPanel}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Border VerticalAlignment="Top" Style="{StaticResource IconBadge}">
                    <ui:SymbolIcon
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="18"
                      Foreground="{StaticResource NeonOrangeBrush}"
                      Symbol="History24" />
                  </Border>

                  <StackPanel Grid.Column="1" Margin="16,0,18,0">
                    <WrapPanel>
                      <TextBlock
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource TechFont}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{Binding Date}" />
                      <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{StaticResource NeonCyanBrush}"
                        Style="{StaticResource TechLabel}"
                        Text="{Binding Reason}" />
                    </WrapPanel>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource NeonMutedBrush}" Text="{Binding Summary}" TextWrapping="Wrap" />
                    <TextBlock
                      Margin="0,4,0,0"
                      FontFamily="{StaticResource MonoFont}"
                      Foreground="{StaticResource NeonTealBrush}"
                      Text="{Binding Names}"
                      TextWrapping="Wrap"
                      Visibility="{Binding HasNames, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                      Margin="0,4,0,0"
                      Foreground="{StaticResource NeonOrangeBrush}"
                      Text="{Binding OtherComputerText}"
                      TextWrapping="Wrap"
                      Visibility="{Binding IsOtherComputer, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>

                  <ui:Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                    CommandParameter="{Binding}"
                    Content="Choisir"
                    Icon="{ui:SymbolIcon ArrowRight24}"
                    IsEnabled="{Binding IsReadable}" />
                </Grid>
              </ContentControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Aucune sauvegarde -->
        <ContentControl fx:Fx.Reveal="True" Style="{StaticResource NeonPanel}" Visibility="{Binding HasNoBackups, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon FontSize="26" Foreground="{StaticResource NeonCyanBrush}" Symbol="Info24" />
            <StackPanel Margin="14,0,0,0">
              <TextBlock FontFamily="{StaticResource TechFont}" FontSize="17" FontWeight="SemiBold" Text="Aucune sauvegarde pour le moment." />
              <TextBlock Foreground="{StaticResource NeonMutedBrush}" Text="Elle sera créée automatiquement la première fois que vous appliquerez des réglages." TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ContentControl>
      </StackPanel>
    </ScrollViewer>

    <!-- ================= Détail d'une sauvegarde ================= -->
    <Grid Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1500" Margin="36,24,36,24">
          <!-- En-tête -->
          <Grid>
            <StackPanel>
              <TextBlock Margin="0,0,0,2" Style="{StaticResource HudCode}" Text="05 · SAUVEGARDES" />
              <TextBlock Style="{StaticResource NeonTitle}" Text="RESTAURATION" />
              <TextBlock
                Margin="0,6,0,0"
                FontFamily="{StaticResource TechFont}"
                FontSize="18"
                FontWeight="SemiBold"
                Text="{Binding SelectionTitle}" />
              <TextBlock Foreground="{StaticResource NeonMutedBrush}" Text="{Binding SelectionSubtitle}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
              <ui:Button Margin="0,0,8,0" Command="{Binding BackCommand}" Content="Autres sauvegardes" Icon="{ui:SymbolIcon ArrowLeft24}" />
              <ui:Button Margin="0,0,8,0" Command="{Binding SelectAllCommand}" Content="Tout cocher" Icon="{ui:SymbolIcon CheckboxChecked24}" />
              <ui:Button Command="{Binding SelectNoneCommand}" Content="Tout décocher" Icon="{ui:SymbolIcon CheckboxUnchecked24}" />
            </StackPanel>
          </Grid>

          <ui:InfoBar
            Title="Restauration impossible"
            Margin="0,18,0,0"
            IsClosable="False"
            IsOpen="{Binding HasError, Mode=OneWay}"
            Message="{Binding Error}"
            Severity="Error" />

          <ContentControl Content="RÉGLAGES À RESTAURER" Style="{StaticResource SectionHeader}" />

          <views:ChecklistView DataContext="{Binding Groups}" Visibility="{Binding DataContext.HasChanges, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}" />

          <!-- Tout est déjà à la valeur enregistrée -->
          <ContentControl fx:Fx.Reveal="True" Style="{StaticResource NeonPanel}" Visibility="{Binding HasNoChanges, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon FontSize="26" Foreground="{StaticResource NeonGreenBrush}" Symbol="CheckmarkCircle24" />
              <StackPanel Margin="14,0,0,0">
                <TextBlock FontFamily="{StaticResource TechFont}" FontSize="17" FontWeight="SemiBold" Text="Rien à restaurer." />
                <TextBlock Foreground="{StaticResource NeonMutedBrush}" Text="Les réglages de cette sauvegarde sont déjà à leur valeur enregistrée." />
              </StackPanel>
            </StackPanel>
          </ContentControl>

          <!-- Autres réglages de la sauvegarde -->
          <ContentControl
            Content="AUTRES RÉGLAGES DE LA SAUVEGARDE"
            Style="{StaticResource SectionHeader}"
            Visibility="{Binding HasOthers, Converter={StaticResource BoolToVisibility}}" />
          <ui:CardExpander
            Margin="0,0,0,8"
            Header="{Binding UnchangedHeader}"
            Visibility="{Binding HasUnchanged, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemTemplate="{StaticResource SimpleRowTemplate}" ItemsSource="{Binding Unchanged}" />
          </ui:CardExpander>
          <ui:CardExpander
            Margin="0,0,0,8"
            Header="{Binding MissingHeader}"
            Visibility="{Binding HasMissing, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemTemplate="{StaticResource SimpleRowTemplate}" ItemsSource="{Binding Missing}" />
          </ui:CardExpander>
        </StackPanel>
      </ScrollViewer>

      <!-- Barre d'action, toujours visible en bas -->
      <Border
        Grid.Row="1"
        Padding="36,14"
        Background="#E6070B14"
        BorderBrush="{StaticResource NeonLineBrush}"
        BorderThickness="0,1,0,0"
        Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}">
        <Grid MaxWidth="1500">
          <StackPanel VerticalAlignment="Center">
            <TextBlock
              FontFamily="{StaticResource TechFont}"
              FontSize="16"
              FontWeight="SemiBold"
              Text="{Binding SelectionText}" />
            <TextBlock
              Foreground="{StaticResource NeonMutedBrush}"
              Text="Les valeurs actuelles sont sauvegardées à leur tour, avec un point de restauration, avant toute modification." />
          </StackPanel>
          <Button
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding RestoreCommand}"
            Content="{Binding RestoreText}" Style="{StaticResource HudButton}" />
        </Grid>
      </Border>
    </Grid>

    <!-- ================= Résultat ================= -->
    <views:ChangeResultView Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibility}}" />

    <!-- ================= Lecture des valeurs actuelles ================= -->
    <Grid Background="#B3030812" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ui:ProgressRing
          Width="60"
          Height="60"
          HorizontalAlignment="Center"
          IsIndeterminate="True" />
        <TextBlock
          Margin="0,18,0,0"
          HorizontalAlignment="Center"
          fx:Fx.Pulse="True"
          Foreground="{StaticResource NeonCyanBrush}"
          Style="{StaticResource TechLabel}"
          Text="LECTURE DES VALEURS ACTUELLES…" />
      </StackPanel>
    </Grid>

    <!-- ================= Restauration en cours ================= -->
    <views:ApplyingOverlay Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</Page>
