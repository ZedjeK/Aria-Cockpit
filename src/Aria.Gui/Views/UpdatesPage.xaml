<Page
  x:Class="Aria.Gui.Views.UpdatesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fx="clr-namespace:Aria.Gui.Effects"
  xmlns:services="clr-namespace:Aria.Gui.Services"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:views="clr-namespace:Aria.Gui.Views"
  Title="Mises à jour"
  Foreground="{StaticResource NeonTextBrush}"
  ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <services:SeverityToBrushConverter x:Key="SeverityBrush" />
    <fx:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <DataTemplate x:Key="SimpleRowTemplate">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
        <TextBlock
          Grid.Column="1"
          Margin="16,0,0,0"
          Foreground="{StaticResource NeonMutedBrush}"
          Text="{Binding Value}"
          TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <!-- ================= Recherche et liste ================= -->
    <Grid Visibility="{Binding ShowResults, Converter={StaticResource InverseBoolToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1500" Margin="36,24,36,24">
          <!-- En-tête -->
          <Grid>
            <StackPanel>
              <TextBlock Margin="0,0,0,2" Style="{StaticResource HudCode}" Text="04 · WINDOWS UPDATE · APPLICATIONS · PILOTES" />
              <TextBlock Style="{StaticResource NeonTitle}" Text="MISES À JOUR" />
              <TextBlock Margin="0,4,0,0" Foreground="{StaticResource NeonMutedBrush}" Text="{Binding Subtitle}" />
            </StackPanel>
            <StackPanel
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Visibility="{Binding HasSearched, Converter={StaticResource BoolToVisibility}}">
              <ui:Button Margin="0,0,8,0" Command="{Binding SelectAllCommand}" Content="Tout cocher" Icon="{ui:SymbolIcon CheckboxChecked24}" />
              <ui:Button Margin="0,0,8,0" Command="{Binding SelectNoneCommand}" Content="Tout décocher" Icon="{ui:SymbolIcon CheckboxUnchecked24}" />
              <ui:Button Command="{Binding SearchCommand}" Content="Rechercher à nouveau" Icon="{ui:SymbolIcon ArrowClockwise24}" />
            </StackPanel>
          </Grid>

          <!-- Avant la première recherche -->
          <ContentControl
            Margin="0,28,0,0"
            fx:Fx.Reveal="True"
            Padding="0"
            Background="{StaticResource HeroBackgroundBrush}"
            Style="{StaticResource NeonPanel}"
            Visibility="{Binding HasSearched, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid fx:Fx.Sweep="True">
              <Grid Margin="28,26">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border VerticalAlignment="Center" Style="{StaticResource IconBadge}">
                  <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="{StaticResource NeonOrangeBrush}"
                    Symbol="ArrowSync24" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,24,0" VerticalAlignment="Center">
                  <TextBlock FontFamily="{StaticResource TechFont}" FontSize="19" FontWeight="SemiBold" Text="Rechercher les mises à jour" />
                  <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{StaticResource NeonMutedBrush}"
                    Text="Windows Update, applications installées (winget) et pilote NVIDIA. Comptez 10 à 60 secondes : la recherche ne modifie rien, vous choisirez ensuite quoi installer."
                    TextWrapping="Wrap" />
                </StackPanel>
                <Button
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Command="{Binding SearchCommand}"
                  Content="Lancer la recherche" Style="{StaticResource HudButton}" />
              </Grid>
            </Grid>
          </ContentControl>

          <!-- Après la recherche -->
          <StackPanel Visibility="{Binding HasSearched, Converter={StaticResource BoolToVisibility}}">
            <ui:InfoBar
              Title="Recherche incomplète"
              Margin="0,18,0,0"
              IsClosable="False"
              IsOpen="{Binding HasErrors, Mode=OneWay}"
              Message="{Binding Errors}"
              Severity="Warning" />

            <ContentControl Content="PILOTE ET BIOS" Style="{StaticResource SectionHeader}" />
            <UniformGrid Columns="2">
              <!-- Pilote NVIDIA -->
              <ContentControl
                Margin="0,0,12,0"
                fx:Fx.Reveal="True"
                Style="{StaticResource NeonPanel}"
                Visibility="{Binding ShowNvidia, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconBadge}">
                      <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="{StaticResource NeonOrangeBrush}"
                        Symbol="Games24" />
                    </Border>
                    <TextBlock
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      Foreground="{StaticResource NeonCyanBrush}"
                      Style="{StaticResource TechLabel}"
                      Text="PILOTE NVIDIA" />
                  </StackPanel>
                  <TextBlock
                    Margin="0,14,0,6"
                    FontFamily="{StaticResource TechFont}"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{Binding NvidiaTone, Converter={StaticResource SeverityBrush}}"
                    Text="{Binding NvidiaMain}" />
                  <TextBlock Foreground="{StaticResource NeonMutedBrush}" Text="{Binding NvidiaDetail}" TextWrapping="Wrap" />
                  <WrapPanel Margin="0,14,0,0">
                    <Button
                      Margin="0,0,8,6"
                      Command="{Binding DownloadNvidiaCommand}"
                      Content="{Binding NvidiaDownloadText}"
                      Visibility="{Binding NvidiaCanDownload, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource HudButton}" />
                    <ui:Button
                      Margin="0,0,8,6"
                      Command="{Binding OpenNvidiaDetailsCommand}"
                      Content="Notes de version"
                      Icon="{ui:SymbolIcon Open24}"
                      Visibility="{Binding NvidiaCanDownload, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button
                      Margin="0,0,8,6"
                      Command="{Binding OpenNvidiaAppCommand}"
                      Content="Application NVIDIA"
                      Icon="{ui:SymbolIcon Open24}"
                      Visibility="{Binding HasNvidiaApp, Converter={StaticResource BoolToVisibility}}" />
                  </WrapPanel>
                </StackPanel>
              </ContentControl>

              <!-- BIOS -->
              <ContentControl
                fx:Fx.Reveal="True"
                fx:Fx.RevealDelay="80"
                Style="{StaticResource NeonPanel}"
                Visibility="{Binding ShowBios, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconBadge}">
                      <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="{StaticResource NeonOrangeBrush}"
                        Symbol="Board24" />
                    </Border>
                    <TextBlock
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      Foreground="{StaticResource NeonCyanBrush}"
                      Style="{StaticResource TechLabel}"
                      Text="BIOS" />
                  </StackPanel>
                  <TextBlock
                    Margin="0,14,0,6"
                    FontFamily="{StaticResource TechFont}"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{Binding BiosMain}" />
                  <TextBlock Foreground="{StaticResource NeonMutedBrush}" Text="{Binding BiosDetail}" TextWrapping="Wrap" />
                  <ui:Button
                    Margin="0,14,0,0"
                    Command="{Binding SearchBiosCommand}"
                    Content="Chercher la page support"
                    Icon="{ui:SymbolIcon Search24}" />
                </StackPanel>
              </ContentControl>
            </UniformGrid>

            <ContentControl Content="MISES À JOUR DISPONIBLES" Style="{StaticResource SectionHeader}" />
            <views:ChecklistView DataContext="{Binding Groups}" Visibility="{Binding DataContext.HasItems, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}" />

            <ContentControl fx:Fx.Reveal="True" Style="{StaticResource NeonPanel}" Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon FontSize="26" Foreground="{StaticResource NeonGreenBrush}" Symbol="CheckmarkCircle24" />
                <StackPanel Margin="14,0,0,0">
                  <TextBlock FontFamily="{StaticResource TechFont}" FontSize="17" FontWeight="SemiBold" Text="Windows et vos applications sont à jour." />
                  <TextBlock Foreground="{StaticResource NeonMutedBrush}" Text="Aucune mise à jour à installer pour le moment." />
                </StackPanel>
              </StackPanel>
            </ContentControl>

            <ui:CardExpander
              Margin="0,8,0,0"
              Header="{Binding SkippedHeader}"
              Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl ItemTemplate="{StaticResource SimpleRowTemplate}" ItemsSource="{Binding Skipped}" />
            </ui:CardExpander>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Barre d'action -->
      <Border
        Grid.Row="1"
        Padding="36,14"
        Background="#E6070B14"
        BorderBrush="{StaticResource NeonLineBrush}"
        BorderThickness="0,1,0,0"
        Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
        <Grid MaxWidth="1500">
          <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
            <TextBlock FontFamily="{StaticResource TechFont}" FontSize="16" FontWeight="SemiBold" Text="{Binding SelectionText}" />
            <TextBlock Foreground="{StaticResource NeonMutedBrush}" Text="{Binding SelectionDetail}" TextWrapping="Wrap" />
          </StackPanel>
          <Button
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding InstallCommand}"
            Content="{Binding InstallText}" Style="{StaticResource HudButton}" />
        </Grid>
      </Border>
    </Grid>

    <!-- ================= Résultat ================= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibility}}">
      <StackPanel MaxWidth="1500" Margin="36,24,36,36">
        <TextBlock Style="{StaticResource NeonTitle}" Text="RÉSULTAT" />

        <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
          <StackPanel Margin="0,0,44,0">
            <TextBlock Foreground="{StaticResource NeonGreenBrush}" Style="{StaticResource StatValue}" Text="{Binding InstalledCount}" />
            <TextBlock Style="{StaticResource TechLabel}" Text="INSTALLÉES" />
          </StackPanel>
          <StackPanel Margin="0,0,44,0">
            <TextBlock Foreground="{StaticResource NeonCyanBrush}" Style="{StaticResource StatValue}" Text="{Binding OtherCount}" />
            <TextBlock Style="{StaticResource TechLabel}" Text="NON INSTALLÉES" />
          </StackPanel>
          <StackPanel>
            <TextBlock Foreground="{StaticResource NeonRedBrush}" Style="{StaticResource StatValue}" Text="{Binding FailedCount}" />
            <TextBlock Style="{StaticResource TechLabel}" Text="ÉCHECS" />
          </StackPanel>
        </StackPanel>

        <ui:InfoBar
          Title="Redémarrage requis"
          Margin="0,18,0,0"
          IsClosable="False"
          IsOpen="{Binding NeedsReboot, Mode=OneWay}"
          Message="Certaines mises à jour ne seront terminées qu'après un redémarrage du PC."
          Severity="Warning" />

        <ContentControl Content="DÉTAIL" Style="{StaticResource SectionHeader}" />
        <ItemsControl ItemsSource="{Binding Results}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ContentControl Margin="0,0,0,8" Padding="16,12" fx:Fx.Reveal="True" Style="{StaticResource NeonPanel}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                      VerticalAlignment="Center"
                      FontFamily="{StaticResource TechFont}"
                      FontSize="16"
                      FontWeight="SemiBold"
                      Text="{Binding Name}"
                      TextWrapping="Wrap" />
                    <TextBlock
                      Grid.Column="1"
                      Margin="16,0"
                      VerticalAlignment="Center"
                      FontFamily="{StaticResource MonoFont}"
                      Foreground="{StaticResource NeonCyanBrush}"
                      Text="{Binding Detail}"
                      Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                      Grid.Column="2"
                      MinWidth="120"
                      VerticalAlignment="Center"
                      Foreground="{Binding Tone, Converter={StaticResource SeverityBrush}}"
                      Style="{StaticResource TechLabel}"
                      Text="{Binding Status}"
                      TextAlignment="Right" />
                  </Grid>
                  <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{StaticResource NeonRedBrush}"
                    Text="{Binding Error}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </ContentControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ContentControl Content="SÉCURITÉ ET TRAÇABILITÉ" Style="{StaticResource SectionHeader}" />
        <ContentControl Style="{StaticResource NeonPanel}">
          <ItemsControl ItemsSource="{Binding ResultNotes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock
                  Margin="0,3"
                  FontFamily="{StaticResource MonoFont}"
                  Foreground="{StaticResource NeonMutedBrush}"
                  Text="{Binding}"
                  TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ContentControl>

        <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
          <Button
            Margin="0,0,8,0"
            Command="{Binding FinishCommand}"
            Content="Terminer" Style="{StaticResource HudButton}" />
          <ui:Button
            Margin="0,0,8,0"
            Command="{Binding OpenReportCommand}"
            Content="Ouvrir le rapport"
            Icon="{ui:SymbolIcon DocumentText24}" />
          <ui:Button
            Command="{Binding RestartCommand}"
            Content="Redémarrer maintenant"
            Icon="{ui:SymbolIcon Power24}"
            Visibility="{Binding NeedsReboot, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ================= Recherche en cours ================= -->
    <Grid
      fx:Fx.Sweep="True"
      Background="#EB030812"
      Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="140" Height="140" HorizontalAlignment="Center">
          <Ellipse
            fx:Fx.Spin="True"
            Stroke="#807DF9FF"
            StrokeDashArray="2 6"
            StrokeThickness="2" />
          <ui:ProgressRing
            Width="90"
            Height="90"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsIndeterminate="True" />
        </Grid>
        <TextBlock
          Margin="0,24,0,18"
          HorizontalAlignment="Center"
          fx:Fx.Pulse="True"
          FontFamily="{StaticResource TechFont}"
          FontSize="20"
          FontWeight="SemiBold"
          Foreground="{StaticResource NeonCyanBrush}"
          Text="RECHERCHE DES MISES À JOUR" />
        <ItemsControl Width="440" ItemsSource="{Binding Sources}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" />
                <TextBlock
                  Grid.Column="1"
                  fx:Fx.Pulse="{Binding IsPending}"
                  Foreground="{Binding Tone, Converter={StaticResource SeverityBrush}}"
                  Style="{StaticResource TechLabel}"
                  Text="{Binding Text}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock
          Margin="0,18,0,0"
          HorizontalAlignment="Center"
          Style="{StaticResource TechLabel}"
          Text="LECTURE SEULE · RIEN N'EST INSTALLÉ" />
      </StackPanel>
    </Grid>

    <!-- ================= Installation en cours ================= -->
    <Grid
      fx:Fx.Sweep="True"
      Background="#EB030812"
      Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="140" Height="140" HorizontalAlignment="Center">
          <Ellipse
            fx:Fx.Spin="True"
            Stroke="#80FF8A1F"
            StrokeDashArray="2 6"
            StrokeThickness="2" />
          <ui:ProgressRing
            Width="90"
            Height="90"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsIndeterminate="True" />
        </Grid>
        <TextBlock
          Margin="0,24,0,4"
          HorizontalAlignment="Center"
          fx:Fx.Pulse="True"
          FontFamily="{StaticResource TechFont}"
          FontSize="20"
          FontWeight="SemiBold"
          Foreground="{StaticResource NeonCyanBrush}"
          Text="INSTALLATION EN COURS" />
        <TextBlock
          HorizontalAlignment="Center"
          Foreground="{StaticResource NeonOrangeBrush}"
          Style="{StaticResource StatValue}"
          Text="{Binding ProgressCounter}" />
        <TextBlock
          MaxWidth="560"
          Margin="0,4,0,0"
          HorizontalAlignment="Center"
          FontFamily="{StaticResource TechFont}"
          FontSize="16"
          Text="{Binding ProgressText}"
          TextAlignment="Center"
          TextWrapping="Wrap" />
        <!-- Élément en cours : téléchargement, puis installation -->
        <TextBlock
          MaxWidth="560"
          Margin="0,6,0,0"
          HorizontalAlignment="Center"
          FontFamily="{StaticResource MonoFont}"
          Foreground="{StaticResource NeonCyanBrush}"
          Text="{Binding ProgressDetail}"
          TextAlignment="Center"
          TextWrapping="Wrap" />
        <ProgressBar
          Width="460"
          Height="4"
          Margin="0,10,0,0"
          IsIndeterminate="{Binding ItemIndeterminate}"
          Maximum="100"
          Value="{Binding ItemPercent, Mode=OneWay}" />
        <!-- Ensemble -->
        <TextBlock
          Margin="0,18,0,4"
          HorizontalAlignment="Center"
          Style="{StaticResource TechLabel}"
          Text="ENSEMBLE" />
        <ProgressBar
          Width="460"
          Height="6"
          Maximum="100"
          Value="{Binding ProgressValue, Mode=OneWay}" />
        <ui:Button
          Margin="0,22,0,0"
          HorizontalAlignment="Center"
          Command="{Binding StopCommand}"
          Content="Arrêter après l'élément en cours"
          Icon="{ui:SymbolIcon Stop24}" />
        <TextBlock
          Margin="0,12,0,0"
          HorizontalAlignment="Center"
          Style="{StaticResource TechLabel}"
          Text="NE PAS ÉTEINDRE LE PC PENDANT L'INSTALLATION" />
      </StackPanel>
    </Grid>

    <!-- ================= Applications ouvertes : avertissement avec compte à rebours ================= -->
    <Grid Background="#EB030812" Visibility="{Binding ShowOpenApps, Converter={StaticResource BoolToVisibility}}">
      <ContentControl
        MaxWidth="720"
        Margin="36"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="28,24"
        Style="{StaticResource NeonPanel}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon
              fx:Fx.Pulse="True"
              FontSize="22"
              Foreground="{StaticResource NeonOrangeBrush}"
              Symbol="Warning24" />
            <TextBlock
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              Foreground="{StaticResource NeonOrangeBrush}"
              Style="{StaticResource TechLabel}"
              Text="APPLICATIONS OUVERTES" />
          </StackPanel>

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
              <TextBlock
                FontFamily="{StaticResource TechFont}"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Ces applications vont être fermées pour leur mise à jour"
                TextWrapping="Wrap" />
              <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding OpenApps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4">
                      <TextBlock FontFamily="{StaticResource TechFont}" FontSize="16" Text="{Binding Name, StringFormat='•  {0}'}" />
                      <TextBlock
                        Margin="16,0,0,0"
                        FontFamily="{StaticResource MonoFont}"
                        Foreground="{StaticResource NeonMutedBrush}"
                        Text="{Binding Processes}"
                        TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Compte à rebours -->
            <Grid Grid.Column="1" Width="130" Height="130" VerticalAlignment="Top">
              <fx:NeonRing ArcBrush="{StaticResource NeonOrangeBrush}" Thickness="9" Value="{Binding CountdownFraction}" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                  HorizontalAlignment="Center"
                  FontFamily="{StaticResource TechFont}"
                  FontSize="40"
                  FontWeight="SemiBold"
                  Foreground="{StaticResource NeonOrangeBrush}"
                  Text="{Binding CountdownText}" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource TechLabel}" Text="SECONDES" />
              </StackPanel>
            </Grid>
          </Grid>

          <TextBlock
            Margin="0,16,0,0"
            Foreground="{StaticResource NeonMutedBrush}"
            Text="Enregistrez votre travail. À la fin du compte à rebours, Aria demande à chaque application de se fermer normalement, puis force sa fermeture au bout de 10 secondes : un fichier non enregistré serait alors perdu."
            TextWrapping="Wrap" />

          <WrapPanel Margin="0,20,0,0">
            <Button
              Margin="0,0,8,6"
              Command="{Binding CloseAppsNowCommand}"
              Content="Fermer maintenant" Style="{StaticResource HudButton}" />
            <ui:Button
              Margin="0,0,8,6"
              Command="{Binding SkipOpenAppsCommand}"
              Content="Ne pas les mettre à jour"
              Icon="{ui:SymbolIcon DismissCircle24}" />
            <ui:Button
              Margin="0,0,8,6"
              Command="{Binding CancelOpenAppsCommand}"
              Content="Annuler"
              Icon="{ui:SymbolIcon Dismiss24}" />
          </WrapPanel>
        </StackPanel>
      </ContentControl>
    </Grid>
  </Grid>
</Page>
